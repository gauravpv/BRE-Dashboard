SELECT 
    DATE(transaction_date) AS transaction_date,
    CONCAT(
        LPAD(bucket * 100, 4, '0'), '-', 
        LPAD((bucket + 1) * 100, 4, '0'), ' MS'
    ) AS time_range,
    COUNT(*) AS transaction_count,
    ROUND(100 * COUNT(*) / total_per_date.total_count, 2) AS percentage
FROM (
    SELECT 
        DATE(AUTH_REQUEST_DATE_TIME) AS transaction_dates,
        FLOOR((TIMESTAMPDIFF(MICROSECOND, API_REQUEST_START_TIME, API_REQUEST_END_TIME) / 1000000) / 0.1) AS bucket
    FROM bre_underwriting.transaction_details_srcreq_otp
    WHERE
        AUTH_REQUEST_DATE_TIME >= ADDDATE(CURDATE(), 0)
        AND AUTH_REQUEST_DATE_TIME < ADDDATE(CURDATE(), 1)
        AND REQ_TYPE = 'AUTOTP'
        -- AND DEALER_CODE_ETAILER = '139908'
       AND AUTH_REQUEST_DATE_TIME >= '2026-09-10 00:00:00'
         AND AUTH_REQUEST_DATE_TIME <= '2026-09-10 19:00:00'
) AS buckets
JOIN (
    SELECT 
        DATE(AUTH_REQUEST_DATE_TIME) AS transaction_date,
        COUNT(*) AS total_count
    FROM bre_underwriting.transaction_details_srcreq_otp
    WHERE
        AUTH_REQUEST_DATE_TIME >= ADDDATE(CURDATE(), 0)
        AND AUTH_REQUEST_DATE_TIME < ADDDATE(CURDATE(), 1)
        AND REQ_TYPE = 'AUTOTP'
        -- AND DEALER_CODE_ETAILER = '139908'
         AND AUTH_REQUEST_DATE_TIME >= '2026-09-10 00:00:00'
         AND AUTH_REQUEST_DATE_TIME <= '2026-09-10 19:00:00'
    GROUP BY DATE(AUTH_REQUEST_DATE_TIME)
) AS total_per_date
    ON buckets.transaction_dates = total_per_date.transaction_date
GROUP BY transaction_date, bucket, total_per_date.total_count
ORDER BY transaction_date, bucket;




